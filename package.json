{
  "name": "rummy500-online",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Rummy 500 con salas privadas, sin cuentas ni base de datos",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.3"
  },
  "engines": { "node": ">=20" }
}
